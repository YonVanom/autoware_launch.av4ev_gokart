<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="control_cmd_topic" default="/control/command/control_cmd"/>
  <arg name="drive_info_topic" default="/drive_info_from_nucleo"/>
  <arg name="gokart_mode_topic" default="/gokart_mode"/>
  <arg name="autonomous_command_topic" default="/automous_command_to_nucleo"/>
  <arg name="control_mode_topic" default="/vehicle/status/control_mode"/>
  <arg name="steering_status_topic" default="/vehicle/status/steering_status"/>
  <arg name="velocity_status_topic" default="/vehicle/status/velocity_status"/>

  <node pkg="av4ev_gokart_interface" exec="av4ev_gokart_interface_node" name="av4ev_gokart_interface_node" output="screen">
    <remap from="~/control/command/control_cmd" to="$(var control_cmd_topic)"/>
    <remap from="~/drive_info_from_nucleo" to="$(var drive_info_topic)"/>
    <remap from="~/gokart_mode" to="$(var gokart_mode_topic)"/>
    <remap from="~/automous_command_to_nucleo" to="$(var autonomous_command_topic)"/>
    <remap from="~/vehicle/status/control_mode" to="$(var control_mode_topic)"/>
    <remap from="~/vehicle/status/steering_status" to="$(var steering_status_topic)"/>
    <remap from="~/vehicle/status/velocity_status" to="$(var velocity_status_topic)"/>
  </node>
</launch>
