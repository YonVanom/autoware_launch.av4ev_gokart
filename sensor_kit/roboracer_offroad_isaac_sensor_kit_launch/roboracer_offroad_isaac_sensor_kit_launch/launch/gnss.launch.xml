<launch>
  <group>
    <push-ros-namespace namespace="gnss"/>
    
    <!-- Parameters -->
    <let name="odomenu_topic_name" value="/ego/odom"/>
    <let name="pose_topic_name" value="/sensing/gnss/pose"/>
    <let name="pose_with_covariance_topic_name" value="/sensing/gnss/pose_with_covariance"/>

    <!-- Odom to Pose conversion (optional) -->
    <include file="$(find-pkg-share isaac_odom_to_pose)/launch/isaac_odom_to_pose.launch.yaml">
      <arg name="input_topic" value="$(var odomenu_topic_name)"/>

      <arg name="output_pose_topic" value="$(var pose_topic_name)"/>
      <arg name="output_pose_with_covariance_topic" value="$(var pose_with_covariance_topic_name)"/>
    </include>
  </group>
</launch>
