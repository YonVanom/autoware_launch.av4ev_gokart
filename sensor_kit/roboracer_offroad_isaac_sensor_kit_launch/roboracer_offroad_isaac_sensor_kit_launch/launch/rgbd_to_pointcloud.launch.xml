<launch>

  <!-- RGB-D to colored point cloud -->
  <node pkg="depth_image_proc"
        exec="point_cloud_xyzrgb_node"
        name="point_cloud_xyzrgb"
        output="screen">

    <remap from="rgb/image_rect_color" to="/ego/rgb"/>
    <remap from="rgb/camera_info" to="/ego/camera_info"/>

    <remap from="depth_registered/image_rect" to="/ego/depth"/>
    <remap from="depth_registered/camera_info" to="/ego/camera_info"/>

    <remap from="points" to="/ego/point_cloud"/>

  </node>

</launch>
