<launch>

  <!-- Camera -->
  <node pkg="topic_tools" exec="relay" name="camera_relay"
        args="/ego/rgb /sensing/camera/rgb/image_raw" output="screen" />

  <!-- IMU -->
  <node pkg="topic_tools" exec="relay" name="imu_relay"
        args="/ego/imu /sensing/imu/imu_raw" output="screen" />

  <!-- LiDAR -->
  <node pkg="topic_tools" exec="relay" name="lidar_relay"
        args="/ego/point_cloud /sensing/lidar/top/pointcloud_raw" output="screen" />

</launch>
