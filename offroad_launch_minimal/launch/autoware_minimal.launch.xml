<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Required -->
  <arg name="map_path" description="point cloud and lanelet2 map directory path"/>
  <arg name="vehicle_model" default="sample_vehicle" description="vehicle model name"/>
  <arg name="sensor_model" default="sample_sensor_kit" description="sensor model name"/>
  <!-- Map -->
  <arg name="lanelet2_map_file" default="lanelet2_map.osm"/>
  <arg name="pointcloud_map_file" default="pointcloud_map.pcd"/>

  <!-- Runtime -->
  <arg name="use_sim_time" default="false"/>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="launch_vehicle_interface" default="true"/>
  <arg name="launch_sensing_driver" default="true"/>

  <!-- Tools -->
  <arg name="rviz" default="true"/>
  <arg name="rviz_config" default="$(find-pkg-share offroad_launch_minimal)/rviz/autoware.rviz"/>

  <!-- Pointcloud container name -->
  <arg name="pointcloud_container_name" default="pointcloud_container"/>

  <!-- System (passed through to localization and other components) -->
  <arg name="system_run_mode" default="online"/>

  <!-- Planning args -->
  <arg name="enable_all_modules_auto_mode" default="false"/>
  <arg name="is_simulation" default="false"/>

  <!-- Control args -->
  <arg name="check_external_emergency_heartbeat" default="false"/>

  <!-- API args -->
  <arg name="scenario_simulation" default="false"/>

  <!-- Global parameters (required by all subsystems) -->
  <group scoped="false">
    <include file="$(find-pkg-share autoware_global_parameter_loader)/launch/global_params.launch.py">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>
  </group>

  <!-- Shared pointcloud container -->
  <include file="$(find-pkg-share offroad_launch_minimal)/launch/pointcloud_container.launch.py">
    <arg name="use_multithread" value="true"/>
    <arg name="container_name" value="$(var pointcloud_container_name)"/>
  </include>

  <!-- Vehicle (description + optional interface) -->
  <include file="$(find-pkg-share offroad_launch_minimal)/launch/components/vehicle_component.launch.xml">
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="vehicle_id" value="$(var vehicle_id)"/>
    <arg name="launch_vehicle_interface" value="$(var launch_vehicle_interface)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="raw_vehicle_cmd_converter_param_path" value="$(find-pkg-share offroad_launch_minimal)/config/vehicle/raw_vehicle_cmd_converter/raw_vehicle_cmd_converter.param.yaml"/>
  </include>

  <!-- Map: pointcloud + lanelet2 -->
  <include file="$(find-pkg-share offroad_launch_minimal)/launch/components/map_component.launch.xml"/>

  <!-- Sensing: LiDAR drivers + pointcloud concatenation -->
  <include file="$(find-pkg-share offroad_launch_minimal)/launch/components/sensing_component.launch.xml">
    <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="launch_sensing_driver" value="$(var launch_sensing_driver)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

  <!-- Localization: NDT scan matcher + EKF -->
  <include file="$(find-pkg-share offroad_launch_minimal)/launch/components/localization_component.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
  </include>

  <!-- Perception: ground segmentation (for AEB) + empty object publisher (no ML detection) -->
  <include file="$(find-pkg-share offroad_launch_minimal)/launch/components/perception_component.launch.xml">
    <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
  </include>

  <!-- Planning: circuit planner + minimal planning modules -->
  <include file="$(find-pkg-share offroad_launch_minimal)/launch/components/planning_component.launch.xml">
    <arg name="module_preset" value="minimal"/>
    <arg name="use_circuit_planner" value="true"/>
    <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="enable_all_modules_auto_mode" value="$(var enable_all_modules_auto_mode)"/>
    <arg name="is_simulation" value="$(var is_simulation)"/>
  </include>

  <!-- Trajectory relay (keeps /planning/scenario_planning/trajectory alive) -->
  <node pkg="topic_tools" exec="relay" name="trajectory_relay">
    <param name="input_topic" value="/planning/trajectory"/>
    <param name="output_topic" value="/planning/scenario_planning/trajectory"/>
  </node>

  <!-- Control: trajectory follower + AEB (use_emergency_handling=false via custom vehicle_cmd_gate config) -->
  <include file="$(find-pkg-share offroad_launch_minimal)/launch/components/control_component.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="check_external_emergency_heartbeat" value="$(var check_external_emergency_heartbeat)"/>
  </include>

  <!-- System: publishes /system/operation_mode/availability so ADAPI can allow mode changes.
       Uses a minimal graph where all modes are always available (type: ok). -->
  <include file="$(find-pkg-share autoware_diagnostic_graph_aggregator)/launch/aggregator.launch.xml">
    <arg name="graph_file" value="$(find-pkg-share offroad_launch_minimal)/config/system/diagnostics/minimal.yaml"/>
  </include>

  <!-- API: manages vehicle cmd gate engagement state -->
  <include file="$(find-pkg-share offroad_launch_minimal)/launch/components/api_component.launch.xml">
    <arg name="scenario_simulation" value="$(var scenario_simulation)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
  </include>

  <!-- RViz (optional) -->
  <node
    pkg="rviz2"
    exec="rviz2"
    name="rviz2"
    output="screen"
    args="-d $(var rviz_config) -s $(find-pkg-share offroad_launch_minimal)/rviz/image/autoware.png"
    if="$(var rviz)"
  >
    <env name="QT_QPA_PLATFORMTHEME" value="qt5ct"/>
  </node>
</launch>
