<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Essential parameters -->
  <arg name="use_sim_time" default="true" description="use simulation time"/>
  <arg name="map_path" description="point cloud and lanelet2 map directory path"/>
  <arg name="vehicle_model" default="sample_vehicle" description="vehicle model name"/>
  <arg name="sensor_model" default="sample_sensor_kit" description="sensor model name"/>
  <arg name="data_path" default="$(env HOME)/autoware_data" description="packages data and artifacts directory path"/>
  <arg name="simulator_type" default="awsim" description="select the simulator type ('awsim' or 'carla')"/>

  <!-- Circuit planner -->
  <arg name="use_circuit_planner" default="false" description="launch circuit route planner for continuous loop driving"/>

  <!-- Modules to be launched -->
  <arg name="vehicle" default="true"/>
  <arg name="system" default="true"/>
  <arg name="map" default="true"/>
  <arg name="sensing" default="true"/>
  <arg name="localization" default="true"/>
  <arg name="perception" default="true"/>
  <arg name="planning" default="true"/>
  <arg name="control" default="true"/>

  <!-- Map -->
  <arg name="lanelet2_map_file" default="lanelet2_map.osm"/>
  <arg name="pointcloud_map_file" default="pointcloud_map.pcd"/>

  <!-- Perception -->
  <arg name="traffic_light_namespace" default="[traffic_light]"/>

  <!-- Vehicle / sensing / system (simulation defaults) -->
  <arg name="launch_vehicle_interface" default="false"/>
  <arg name="launch_sensing_driver" default="false"/>
  <arg name="launch_system_monitor" default="false"/>
  <arg name="launch_dummy_diag_publisher" default="false"/>

  <!-- Tools -->
  <arg name="rviz" default="true"/>
  <arg name="rviz_config_name" default="autoware.rviz"/>
  <arg name="rviz_config" default="$(find-pkg-share offroad_launch)/rviz/$(var rviz_config_name)"/>

  <group scoped="false" if="$(eval '\'$(var simulator_type)\' == \'carla\'')">
    <include file="$(find-pkg-share autoware_carla_interface)/autoware_carla_interface.launch.xml"/>
  </group>

  <group scoped="false">
    <include file="$(find-pkg-share offroad_launch)/launch/autoware.launch.xml">
      <!-- Common -->
      <arg name="map_path" value="$(var map_path)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
      <arg name="sensor_model" value="$(var sensor_model)"/>
      <arg name="data_path" value="$(var data_path)"/>
      <!-- Lite-specific overrides -->
      <arg name="planning_module_preset" value="lite"/>
      <arg name="control_module_preset" value="lite"/>
      <arg name="use_empty_dynamic_object_publisher" value="true"/>
      <arg name="use_perception_analytics_publisher" value="false"/>
      <arg name="use_circuit_planner" value="$(var use_circuit_planner)"/>
      <!-- Modules to be launched -->
      <arg name="launch_vehicle" value="$(var vehicle)"/>
      <arg name="launch_map" value="$(var map)"/>
      <arg name="launch_sensing" value="$(var sensing)"/>
      <arg name="launch_localization" value="$(var localization)"/>
      <arg name="launch_perception" value="$(var perception)"/>
      <arg name="launch_planning" value="$(var planning)"/>
      <arg name="launch_control" value="$(var control)"/>
      <!-- Global parameters -->
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <!-- Vehicle -->
      <arg name="launch_vehicle_interface" value="$(var launch_vehicle_interface)"/>
      <!-- Map -->
      <arg name="lanelet2_map_file" value="$(var lanelet2_map_file)"/>
      <arg name="pointcloud_map_file" value="$(var pointcloud_map_file)"/>
      <!-- System -->
      <arg name="launch_system_monitor" value="$(var launch_system_monitor)"/>
      <arg name="launch_dummy_diag_publisher" value="$(var launch_dummy_diag_publisher)"/>
      <arg name="diagnostic_graph_aggregator_graph_path" value="$(find-pkg-share offroad_launch)/config/system/diagnostics/autoware-$(var simulator_type).yaml"/>
      <!-- Sensing -->
      <arg name="launch_sensing_driver" value="$(var launch_sensing_driver)"/>
      <!-- Perception -->
      <arg name="traffic_light_recognition/use_high_accuracy_detection" value="false"/>
      <arg name="traffic_light_recognition/camera_namespaces" value="$(var traffic_light_namespace)"/>
      <!-- Tools -->
      <arg name="rviz" value="$(var rviz)"/>
      <arg name="rviz_config" value="$(var rviz_config)"/>
    </include>
  </group>
</launch>
